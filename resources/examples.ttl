@prefix :  </examples/> .

:rule :recipe "Always group by plan version timestamp and gate in the query." .
:rule :recipe "Always summarize the results in the query." .

:opt_plan :name "Optimization plan" ;
    :query_string "optimization plan" ;
    :recipe "An optimization plan runs the optimizer to assign a markdown price to each store-item part of the plan. A plan is identified by a plan ID. Multiple versions of a plan can be created over time." .
    # With each version the markdown percent, achieved STR and markdown spend may change because of changes to the inputs, guardrails and constraints in the optimizer.
    # :refrence :md ;
    # :reference :str ;
    # :reference :md_spnd ;
    # :reference :opt .

:opt :name "Optimizer" ;
    :query_string "optimizer" ;
    :query_string "optimization" ;
    :recipe "The optimizer is a system which uses elasticity to find the optimum reduction in markdown price (equivalent to an increment in markdown percent) which increases sales (and achieved STR) by an optimum amount. The objective is to meet the target STR for each store-item while keeping markdown price and markdown percent within guardrails and constraining the markdown spend within the budget for all the store-items. Other inputs to the optimizer are the gate date and the starting inventory at gate for the store-time." ;
    :reference :elst ;
    :reference :sic ;
    :reference :grd_rail ;
    :reference :bdgt ;
    :reference :inv ;
    :hint :oos .

:oos :recipe "Sales can never exceed the starting inventory. If the sales equals the inventory or the inventory is zero it is called an Out Of Stock event. In this event sales (and STR) do not increase with any increase in markdown percent irrespective of elasticity." .

:grd_rail :name "Guardrails" ;
    :recipe "Guardrails are the constraints price and discount (markdown percent): minimum and maximum feasible price, minimum and maximum discount percentage and minimum absolute discount (dollar markdown)." .

# :bdgt :name "Budget" ;
    # :recipe "Budget is a constraint on total markdown spend." .

:elst :name "Elasticity" ;
    :recipe "Elasticity is a number which tells the expected increase in sales with a decrease in price. It is equivalent to the expected increase in STR by increase in markdown percent." ;
    :reference :str ;
    :reference :md .

:opt_res :name "optimization results" ;
    :query_string "optimization results" ;
    :query_string "optimization reasons" ;
    :query_string "pricing reasons" ;
    :query_string "markdown reasons" ;
    :recipe "It is defined as: the distribution by markdown reason codes." .
    # The optimization may succeed or fail or not run. Optimization result and the reason it failed or was not run are captured in markdown reason codes.

:dol_md :name "dollar markdown" ;
    :query_string "What is dollar markdown?" ;
    # :query_string "What is doll mkdn?" ;
    # :query_string "What is dol md?" ;
    :query_string "What is absolute discount?" ;
    :recipe "It is defined as: markdown prior price - markdown price ." .

:md :name "markdown percentage (discount)" ;
    :query_string "What is markdown percentage?" ;
    # :query_string "What is md?" ;
    # :query_string "What is mkdn?" ;
    # :query_string "What is markdown percent?" ;
    # :query_string "what is mkdn pct?" ;
    :query_string "What is discount?" ;
    :recipe "It is defined as: dollar markdown * 100/ markdown prior price ." ;
    :hint :md_avg ;
    :hint :md_wt_avg ;
    :hint :md_bin ;
    :hint :pctl ;
    :hint :pct ;
    :hint :zero_div_err ;
    :reference :dol_md ;
    :reference :inv .

:md_avg :recipe "To find average markdown percent: compute sum of dollar markdown/ sum of markdown prior price . Do not use SQL AVG function." .
:md_wt_avg :recipe "To weight average: weight with starting inventory. Compute sum of weighted markdown percent/ sum of starting inventory" .
:md_bin :recipe "To group by markdown precent: discretize into fixed width bins of width 10% and an upper limit of 100%. Negative or zero, Nulls and > 100% each are separate bins. Group by the bins." .
:pctl :recipe "To find percentile use SQL APPROX_QUANTILES function." .
:pct :recipe "It is a percentage." .
:zero_div_err :recipe "Use CASE statement to avoid zero division error." .

:inv :name "starting inventory" ;
    :query_string "What is starting inventory?" ;
    :query_string "What is starting on hands quantity?" ;
    :recipe "It is defined as: projected starting inventory + projected upstream inventory ." .

:str :name "STR" ;
    :query_string "What is Sell Through Rate?" ;
    :query_string "What is STR?" ;
    :recipe "It is defined as: sales quantity (units) * 100/ starting inventory ." ;
    :hint :str_avg ;
    :hint :str_wt_avg ;
    :hint :pctl ;
    :hint :pct ;
    :hint :zero_div_err ;
    :reference :inv .

:str_avg :recipe "To find average STR: compute weighted average STR. Do not use SQL AVG function." .
:str_wt_avg :recipe "To weight average: weight with starting inventory. Compute sum of weighted STR/ sum of starting inventory ." .

:sic :name "store-item" ;
    :query_string "What is a store-item combination?" ;
    :query_string "What is a store-item?" ;
    # :query_string "What is a SIC?" ;
    :recipe "It is defined as: concatenation of store number and item number ." ;
    :hint :cat .

:cat :recipe "Use SQL CONCAT function." .

:md_spnd :name "markdown spend" ;
    :query_string "What is markdown spend?" ;
    # :query_string "What is mkdn spend?" ;
    # :query_string "What is md spend?" ;
    :recipe "It is defined as: (markdown percent/ 100) * markdown prior price * starting inventory ." ;
    :reference :md ;
    :reference :inv ;
    :hint :doll .

:doll :recipe "It is dollar amount." .

:sum_stat :name "Summary statistics" ;
    :query_string "summary statistics" ;
    :recipe "minimum markdown percent, maximum markdown percent, average markdown percent, weighted average markdown percent, 10th percentile markdown percent, 90th percentile markdown percent, average STR, total starting inventory, total markdown spend and number of SICs." ;
    :reference :md ;
    :reference :str ;
    :reference :md_spnd ;
    :reference :inv ;
    :reference :sic .

