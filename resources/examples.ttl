@prefix :  </examples/> .

:opt :query_string "markdown optimization" ;
    :recipe """is a model which uses elasticity to find the optimum markdown price (and markdown percent) for each store-item such that sales (and STR) increase. The objective is to meet the target STR while keeping markdown percent and markdown price within guardrails and constraining the markdown spend to stay within budget.
Elasticity is a number which tells the expected increase in sales with a decrease in price. It is equivalent to the expected increase in STR by increase in markdown percent.
Guardrails are constraints on price and discount input by the user.
""" .

:sic :query_string "store-item combination (SIC)" ;
    :recipe "Concatenate store number and item number." ;
    :suggestion :cat .

:cat :recipe "Use SQL CONCAT function." .

:dol_md :query_string "dollar markdown (absolute discount)" ;
    :recipe "markdown prior price - markdown price" .

:md :query_string "markdown (discount)" ;
    :recipe "dollar markdown/ markdown prior price" ;
    :suggestion :md_avg ;
    :suggestion :wt_avg ;
    :suggestion :md_bin ;
    :suggestion :pctl ;
    :reference :dol_md ;
    :reference :inv .

:md_avg :recipe "Average is computed as: sum of dollar markdown/ sum of markdown prior price." .

:wt_avg :recipe "Weighted average is computed as: sum of column weighted with starting inventory/ sum of starting inventory" .

:md_bin :recipe "To group by markdown: discretize markdown into fixed width bins of width 10% and an upper limit of 100%. Negative or zero, Nulls and > 100% each are separate bins. Group by the bins." .

:inv :query_string "starting inventory" ;
    :recipe "projected starting inventory + projected upstream inventory" .

:pctl :recipe "To find percentile use SQL APPROX_QUANTILES function." .

:md_spnd :query_string "markdown spend" ;
    :recipe "dollar markdown * starting inventory" ;
    :reference :dol_md ;
    :reference :inv ;
    :suggestion :chng ;
    :suggestion :chng_rsn .

:chng :recipe "To find a change in it find the change over time, i.e., change in its value from the previous plan run timestamp. Calculate its value - its value for the previous plan run timestamp ." .

:chng_rsn :recipe "To explain why it has changed: find the change in optimization result by gate and plan run timestamp. Optimization result is the distribution by markdown reason codes." .

:str :query_string "Sell Through Rate (STR)" ;
    :recipe "sales quantity (units)/ starting inventory" ;
    :suggestion :str_avg ;
    :suggestion :wt_avg ;
    :suggestion :pctl ;
    :reference :inv .

:str_avg :recipe "Average is computed as: weighted average of STR." .

:sum_stat :query_string "summary statistics" ;
    :recipe "minimum markdown percent, maximum markdown percent, average markdown percent, weighted average markdown percent, 10th percentile markdown percent, 90th percentile markdown percent, average STR, total starting inventory and number of SICs." ;
    :reference :md ;
    :reference :str ;
    :reference :sic ;
    :reference :inv .
