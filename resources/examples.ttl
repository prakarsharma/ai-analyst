:val :name "Value" ;
    :query_string "Reasons for its low value." ;
    :query_string "Reasons for its high value." ;
    # :query_string "Reasons for its assigned value." ;
    :query_string "Reasons why it has been assigned this value." ;
    :recipe "Find the values of all the factors which could have affected its value." ;
    :reference :opt_plan .

